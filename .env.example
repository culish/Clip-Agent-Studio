# Salin file ini menjadi ".env" lalu isi SALAH SATU penyedia LLM di bawah.

# --- Pilihan 1: Google Gemini (ada kuota gratis) — https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-flash-latest
# Model cadangan bila model utama sibuk (pisahkan dengan koma):
# LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Pilihan 2: OpenRouter (banyak model gratis berakhiran :free) — https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL=           # isi nama model dari https://openrouter.ai/models?q=free

# --- Pilihan 3: Ollama (lokal, gratis, offline) — https://ollama.com
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# --- Pilihan 4: Claude (Anthropic)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# --- Lainnya: groq (GROQ_API_KEY) atau openai (OPENAI_API_KEY)
# Endpoint kompatibel-OpenAI lain: set LLM_BASE_URL, LLM_API_KEY, dan LLM_MODEL.

# Opsional: ambil cookies dari browser bila YouTube meminta "Sign in to confirm you're not a bot"
# (firefox paling andal; chrome/edge/brave juga bisa)
# COOKIES_FROM_BROWSER=firefox

# Opsional: ukuran potongan transkrip per permintaan (karakter)
# CHUNK_CHARS=60000

# Akses dari HP (diatur otomatis dari tab Pengaturan > Akses dari HP)
# LAN_ENABLED=1
# LAN_ACCESS_CODE=XXXX-XXXX

# Gambar AI untuk cover & gaya animasi "Ilustrasi AI" (opsional; memakai GEMINI_API_KEY bila IMAGE_API_KEY kosong).
# Model gambar Gemini dapat dikenai biaya; cek kuota akun Anda.
# IMAGE_MODEL=gemini-3.1-flash-lite-image
# IMAGE_API_KEY=

# Remotion (animasi/kartun) memakai Chrome Headless Shell yang diunduh otomatis pada render pertama.
# Bila unduhan terblokir, arahkan ke Chrome/Chromium yang sudah terpasang:
# REMOTION_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Studio: riset viral, buat video, edit otomatis (semua opsional; bisa diisi dari tab Pengaturan)
# YouTube Data API key: riset viral lebih cepat & lengkap (subscriber, like, komentar). console.cloud.google.com
# YOUTUBE_API_KEY=
# Pexels API key: b-roll video stok gratis. pexels.com/api
# PEXELS_API_KEY=
# Model suara narasi (Gemini TTS) dan video AI (berbayar, sekitar US$0,10 per detik 720p)
# TTS_MODEL=gemini-3.8-flash-tts
# VIDEO_MODEL=gemini-omni-1.1-flash

# --- Posting otomatis (biasanya diisi dari tab Posting)
# OAuth Client jenis "Desktop app" dari Google Cloud Console untuk upload ke YouTube
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# Versi Graph API Meta (Facebook/Instagram)
# META_GRAPH_VERSION=v26.0
